# shared logic
(common_site) {
	root * /var/www/html
	file_server

	encode zstd gzip

	# Uncomment for http3
	#header Alt-Svc `h3=":443"; ma=2592000`

	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	header X-Content-Type-Options "nosniff"
	header X-Frame-Options "SAMEORIGIN"
	header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"

	@blocked {
		path_regexp (?i)(^\.\./|\.(env|git|htaccess|ssh|asp|php|aspx|sql|bak|config|yaml|yml|ini|log)$|/(wp-admin|wp-login|phpmyadmin|admin|backup|config|db|setup|shell|api/v1/user/config)|/(uploads|temp|tmp|scripts|bin|etc|var|usr)/.*\.sh$)
	}
	handle @blocked {
		abort
	}

	handle /manifest.json {
		header Content-Type "application/manifest+json"
		file_server
	}

	@assets {
		path *.css *.js *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff2 *.mp4 *.webm
	}
	handle @assets {
		header Cache-Control "public, max-age=2592000"
		file_server
	}
}

# Redirect HTTP
http://<NODE_DOMAIN>, http://<NODE_DOMAIN2> {
	log {
		output stdout
		format json
	}

	redir https://{host}{uri} permanent
}

# Main server (:8443 for http3)
https://<NODE_DOMAIN>, https://<NODE_DOMAIN2> {
	log {
		output stdout
		format json
	}

	bind unix//dev/shm/caddy.sock # 127.0.0.1 for http3

	# Load local certs
	tls /etc/caddy/ssl/fullchain.pem /etc/caddy/ssl/privkey.key

	# xHTTP v1
	reverse_proxy /api/v1/network/XzTfN6LEnn7wWDJww* unix//dev/shm/xr-vxht.sock {
		transport http {
			versions h2c 2
		}
		flush_interval -1
		header_up X-Real-IP {client_ip}
		header_up -Via
	}

	# WebSocket v1
	reverse_proxy /api/v1/network/WPkUXTWEmMtrTtAm5* unix//dev/shm/xr-vwst.sock {
		flush_interval -1
		header_up X-Real-IP {client_ip}
		header_up -Via
	}

	# gRPC v1
	@grpc {
		protocol grpc
		path /apiRequestInteractionService/*
	}
	reverse_proxy @grpc unix//dev/shm/xr-vgrt.sock {
		transport http {
			versions h2c 2
		}
		flush_interval -1
		header_up X-Real-IP {client_ip}
		header_up -Via
	}

	import common_site
}

# Selfsteal server 1
:8444 {
	log {
		output stdout
		format json
	}

	bind 127.0.0.1

	# Load local certs
	tls /etc/caddy/ssl/fullchain.pem /etc/caddy/ssl/privkey.key

	@self host <NODE_DOMAIN2>
	handle @self {
		import common_site
	}

	handle {
		import common_site
	}
}
